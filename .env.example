# Copy to .env.local (git-ignored) and adjust.

# Where the app looks for PocketBase.
#   desktop  -> http://127.0.0.1:8090
#   phone    -> http://<windows-lan-ip>:8090
VITE_PB_URL=http://127.0.0.1:8090

# Optional: absolute path to the Claude Code binary, if `claude` is not on PATH
# for the process that launches the app.
# AIS_CLAUDE_BIN=C:\Users\you\AppData\Roaming\npm\claude.cmd
